      ],
      "interpreterVersion": 1,
      "code": "/**\r\n * Von Karman nose cone (Haack series, C = 1/3) — minimum drag for a given length and diameter.\r\n * Solid of revolution around the X axis; tip at x=0, base at x=length.\r\n * length and outerDiameter in mm.\r\n */\r\nfunction run(length: number = 100, outerDiameter: number = 40): Assembly {\r\n  const R = outerDiameter / 2;\r\n  const C = 1 / 3;\r\n  const numPoints = 50;\r\n\r\n  function radiusAt(x: number): number {\r\n    const theta = Math.acos(1 - (2 * x) / length);\r\n    return (\r\n      (R / Math.sqrt(Math.PI)) *\r\n      Math.sqrt(theta - Math.sin(2 * theta) / 2 + C * Math.pow(Math.sin(theta), 3))\r\n    );\r\n  }\r\n\r\n  const points: [number, number][] = [[0, 0]];\r\n  for (let i = 1; i <= numPoints; i++) {\r\n    const x = (i / numPoints) * length;\r\n    points.push([x, radiusAt(x)]);\r\n  }\r\n  points.push([length, 0]);\r\n\r\n  let pen = replicad.draw(points[0]);\r\n  for (let i = 1; i < points.length; i++) {\r\n    pen = pen.lineTo(points[i]);\r\n  }\r\n  const profile = pen.close();\r\n\r\n  const noseCone = profile.sketchOnPlane().revolve([1, 0, 0], { angle: 360 });\r\n\r\n  return new Assembly({\r\n    geometry: noseCone,\r\n    tags: [\"nose-cone\", \"von-karman\"],\r\n    bom: [`Von Karman nose cone, length ${length}mm, outer diameter ${outerDiameter}mm`],\r\n  });\r\n}",
      "compiledCode": "\"use strict\";\n/**\n * Von Karman nose cone (Haack series, C = 1/3) — minimum drag for a given length and diameter.\n * Solid of revolution around the X axis; tip at x=0, base at x=length.\n * length and outerDiameter in mm.\n */\nfunction run(length = 100, outerDiameter = 40) {\n    const R = outerDiameter / 2;\n    const C = 1 / 3;\n    const numPoints = 50;\n    function radiusAt(x) {\n        const theta = Math.acos(1 - (2 * x) / length);\n        return ((R / Math.sqrt(Math.PI)) *\n            Math.sqrt(theta - Math.sin(2 * theta) / 2 + C * Math.pow(Math.sin(theta), 3)));\n    }\n    const points = [[0, 0]];\n    for (let i = 1; i <= numPoints; i++) {\n        const x = (i / numPoints) * length;\n        points.push([x, radiusAt(x)]);\n    }\n    points.push([length, 0]);\n    let pen = replicad.draw(points[0]);\n    for (let i = 1; i < points.length; i++) {\n        pen = pen.lineTo(points[i]);\n    }\n    const profile = pen.close();\n    const noseCone = profile.sketchOnPlane().revolve([1, 0, 0], { angle: 360 });\n    return new Assembly({\n        geometry: noseCone,\n        tags: [\"nose-cone\", \"von-karman\"],\n        bom: [`Von Karman nose cone, length ${length}mm, outer diameter ${outerDiameter}mm`],\n    });\n}\n"
    }
  ],
